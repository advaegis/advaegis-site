{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm ci)",
      "Bash(npm ls*)",
      "Bash(npm outdated*)",
      "Bash(npx astro check*)",
      "Bash(node --test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr comment*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm uninstall*)",
      "Bash(npm update*)",
      "Bash(brew install*)",
      "Bash(brew upgrade*)",
      "Bash(brew uninstall*)",
      "Bash(gh repo edit*)",
      "Bash(gh secret*)",
      "Bash(gh api*)"
    ],
    "deny": [
      "Bash(git push* main*)",
      "Bash(git push*:main*)",
      "Bash(git push*--force*)",
      "Bash(git push*-f *)",
      "Bash(gh pr merge*)",
      "Bash(wrangler deploy*)",
      "Bash(npx wrangler deploy*)",
      "Bash(wrangler versions deploy*)",
      "Bash(npx wrangler versions deploy*)",
      "Bash(wrangler secret*)",
      "Bash(npx wrangler secret*)",
      "Bash(wrangler delete*)",
      "Bash(npx wrangler delete*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars*)"
    ]
  }
}
