---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
const { company } = site;
---

<Base title="Contact" description="How to contact Advaegis.">
  <section class="wrap page-intro">
    <h1>Contact</h1>
    <p class="lede">For consulting enquiries, product questions or anything else, email us.</p>
    <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
  </section>

  <section class="section" aria-labelledby="company-title">
    <div class="wrap">
      <h2 id="company-title">Company details</h2>
      <dl class="details">
        <dt>Company name</dt>
        <dd>{company.legalName}</dd>
        <dt>Company number</dt>
        <dd>{company.number}</dd>
        <dt>Registered in</dt>
        <dd>{company.jurisdiction}</dd>
        <dt>Registered office</dt>
        <dd>{company.registeredOffice}</dd>
        {company.vatNumber && (
          <>
            <dt>VAT number</dt>
            <dd>{company.vatNumber}</dd>
          </>
        )}
      </dl>
    </div>
  </section>
</Base>

<style>
  .email {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--ink);
    text-decoration-color: var(--verdigris);
    text-decoration-thickness: 3px;
    overflow-wrap: anywhere;
  }
  .details {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.75rem 2rem;
  }
  .details dt {
    color: var(--slate);
  }
  .details dd {
    margin: 0;
  }
  @media (max-width: 30rem) {
    .details {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .details dd {
      margin-bottom: 0.75rem;
    }
  }
</style>
