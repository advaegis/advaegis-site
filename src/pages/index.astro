---
import Base from '../layouts/Base.astro';
import LayeredShield from '../components/LayeredShield.astro';
import ProductFeature from '../components/ProductFeature.astro';
import ServiceList from '../components/ServiceList.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { getProducts } from '../lib/products';

const products = await getProducts();
---

<Base>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero__text">
      <h1 id="hero-title">Stay a step ahead.</h1>
      <p class="lede">
        Advaegis builds technology that helps people and small businesses stay on top of
        everyday life, and helps engineering teams keep their platforms dependable and put GenAI
        to work.
      </p>
      <p class="hero__actions">
        <a class="button button--solid" href="/products/">See our products</a>
        <a class="button" href="/consulting/">Explore consulting</a>
      </p>
    </div>
    <LayeredShield />
  </section>

  <section class="section" aria-labelledby="products-title">
    <div class="wrap">
      <h2 id="products-title">What we're building</h2>
      <div class="stack">
        {products.map((product) => <ProductFeature product={product} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="consulting-title">
    <div class="wrap">
      <h2 id="consulting-title">Consulting</h2>
      <p class="lede">
        Hands-on help with the layers that keep systems dependable, from architecture at the
        core to GenAI at the edge.
      </p>
      <ServiceList />
      <p class="more"><a href="/consulting/">How we work with clients</a></p>
    </div>
  </section>

  <ContactBlock />
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem) var(--space-section);
  }
  .hero h1 {
    max-width: 11ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .stack {
    display: grid;
    gap: var(--space-section);
    margin-top: 2.5rem;
  }
  .more {
    margin-top: 2rem;
  }
  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero :global(.shield) {
      max-width: 18rem;
    }
  }
</style>
