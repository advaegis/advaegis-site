---
import { site } from '../site.config';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Get in touch',
  text = 'For consulting enquiries, product questions or anything else, email us.',
} = Astro.props;
---

<section class="section contact" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 id="contact-title">{title}</h2>
    <p class="lede">{text}</p>
    <a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</section>

<style>
  .contact__email {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration-color: var(--verdigris);
    text-decoration-thickness: 2px;
    overflow-wrap: anywhere;
  }
  .contact__email:hover {
    text-decoration-thickness: 4px;
  }
</style>
