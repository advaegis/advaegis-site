---
/**
 * A product shown as text beside a phone screenshot.
 * Used on the home page and the products list; the product page
 * renders the full description and every screenshot itself.
 */
import { availability, productHref, type Product } from '../lib/products';

interface Props {
  product: Product;
  headingLevel?: 'h2' | 'h3';
}
const { product, headingLevel: Heading = 'h3' } = Astro.props;
const { name, summary, icon, screenshots } = product.data;
const shot = screenshots[0];
---

<article class="product">
  <div class="product__text">
    <img class="product__icon" src={icon} alt="" width="64" height="64" loading="lazy" />
    <Heading class="product__name">{name}</Heading>
    <p class="product__status">{availability(product)}</p>
    <p class="lede">{summary}</p>
    <a class="button" href={productHref(product)}>About {name}</a>
  </div>
  {shot && (
    <img
      class="product__shot"
      src={shot.src}
      alt={shot.alt}
      width="390"
      height="844"
      loading="lazy"
    />
  )}
</article>

<style>
  .product {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .product__icon {
    border-radius: 14px;
    margin-bottom: 1.25rem;
  }
  .product__name {
    font-size: var(--step-3);
    margin-bottom: 0.25rem;
  }
  .product__status {
    color: var(--verdigris-deep);
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .product__shot {
    width: clamp(220px, 26vw, 300px);
    border-radius: 28px;
    border: 1px solid var(--mist);
  }
  @media (max-width: 44rem) {
    .product {
      grid-template-columns: 1fr;
    }
    .product__shot {
      justify-self: center;
    }
  }
</style>
