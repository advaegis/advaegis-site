---
import { site } from '../site.config';
const { company } = site;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <nav aria-label="Footer">
      <ul class="footer__links">
        {site.nav.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </nav>
    <p class="footer__legal">{site.nameNote}</p>
    <p class="footer__legal">
      {company.legalName} is a private limited company registered in {company.jurisdiction},
      company number {company.number}. Registered office: {company.registeredOffice}.
      {company.vatNumber && <> VAT number {company.vatNumber}.</>}
    </p>
    <p class="footer__legal">© {year} {company.legalName}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--mist);
    padding-block: 2.5rem 3rem;
    font-size: var(--step--1);
    color: var(--slate);
  }
  .footer__inner {
    display: grid;
    gap: 0.75rem;
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 0.75rem;
  }
  .footer__links a {
    color: var(--ink);
  }
  .footer__legal {
    margin: 0;
    max-width: 70ch;
  }
</style>
