---
/**
 * Advaegis logo: three nested shields (layers of protection)
 * with an optional wordmark. Geometry comes from lib/shield.ts.
 */
import { shieldPath } from '../lib/shield';

interface Props {
  size?: number;
  wordmark?: boolean;
}
const { size = 32, wordmark = true } = Astro.props;

const layers = [1, 0.66, 0.32];
---

<span class="mark">
  <svg
    width={size}
    height={size}
    viewBox="-1.15 -0.85 2.3 1.9"
    aria-hidden="true"
    focusable="false"
  >
    {layers.slice(0, 2).map((w) => (
      <path d={shieldPath(w)} fill="none" stroke="currentColor" stroke-width="0.13" />
    ))}
    <path d={shieldPath(layers[2])} class="mark__core" />
  </svg>
  {wordmark && <span class="mark__word">advaegis</span>}
</span>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
  }
  .mark__core {
    fill: var(--verdigris);
  }
  .mark__word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }
</style>
